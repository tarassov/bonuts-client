{
	"name": "bonuts-client",
	"version": "0.1.0",
	"homepage": "https://develop.bonuts.ru",
	"private": true,
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@hookform/resolvers": "^3.3.1",
		"@mui/icons-material": "^6.5.0",
		"@mui/lab": "6.0.1-beta.36",
		"@mui/material": "^6.5.0",
		"@mui/system": "^6.5.0",
		"@mui/x-date-pickers": "^7.23.0",
		"@react-spring/web": "9.5.5",
		"@reduxjs/toolkit": "^2.11.2",
		"@tanstack/match-sorter-utils": "^8.8.4",
		"@tanstack/react-table": "^8.13.2",
		"@tanstack/react-virtual": "^3.2.0",
		"@vkid/sdk": "^2.6.5",
		"camelcase-keys": "^10.0.2",
		"classnames": "^2.3.2",
		"date-fns": "^2.30.0",
		"date-fns-tz": "^2.0.0",
		"fast-equals": "^4.0.3",
		"history": "^5.3.0",
		"i18next": "^26.7.2",
		"i18next-browser-languagedetector": "^7.0.1",
		"i18next-http-backend": "4.0.10",
		"lodash": "4.18.1",
		"match-sorter": "^6.3.1",
		"notistack": "^3.0.1",
		"ramda": "^0.32.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.69.0",
		"react-hook-form-mui": "^7.6.2",
		"react-i18next": "^17.1.13",
		"react-intersection-observer": "^9.13.0",
		"react-markdown": "^10.1.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "6.30.6",
		"react-svg": "^16.1.33",
		"reagraph": "^4.32.0",
		"redux": "^5.0.1",
		"redux-first-history": "^5.2.0",
		"redux-thunk": "^3.1.0",
		"remark-gfm": "^4.0.1",
		"sass": "^1.57.1",
		"snakecase-keys": "^9.0.2",
		"spacetime": "^7.5.0",
		"timezone-soft": "^1.5.1",
		"usehooks-ts": "^2.16.0",
		"web-vitals": "^3.0.4",
		"yup": "^1.3.0"
	},
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"dev:e2e": "cross-env VITE_API_URL=/api/v1 VITE_USE_LOCAL_HOST=false vite --mode e2e --port 4173",
		"storybook": "cross-env NODE_OPTIONS=--max-old-space-size=4096 storybook dev -p 6006 --host 0.0.0.0",
		"build-storybook": "cross-env NODE_OPTIONS=--max-old-space-size=4096 storybook build",
		"build": "tsc && vite build",
		"build-staging": "tsc && vite build --mode staging",
		"serve": "vite preview",
		"test": "vitest",
		"test:withoutWatch": "vitest run",
		"typecheck": "tsc --noEmit",
		"fsd:check": "node scripts/check-fsd-boundaries.mjs",
		"fsd:check:changed": "node scripts/check-fsd-boundaries.mjs --changed",
		"fsd:check:working-tree": "node scripts/check-fsd-boundaries.mjs --working-tree",
		"fsd:check:ci": "node scripts/check-fsd-boundaries.mjs --ci-changed",
		"fsd:check:staged": "node scripts/check-fsd-boundaries.mjs --staged",
		"generate-api": "npx @rtk-query/codegen-openapi openapi-config.ts && biome check --write src/services/api/bonuts-api.ts",
		"lint": "yarn typecheck && yarn e2e:typecheck && biome check src e2e playwright.config.ts && yarn fsd:check:working-tree",
		"lint:fix": "yarn typecheck && yarn e2e:typecheck && biome check --write src e2e playwright.config.ts && yarn fsd:check:working-tree",
		"biome": "biome check src --diagnostic-level=error",
		"biome:fix": "biome check --write src",
		"prepare": "husky",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist -t",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report",
		"e2e:typecheck": "tsc --project e2e/tsconfig.json"
	},
	"browserslist": {
		"production": [">0.2%", "not dead", "not op_mini all"],
		"development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@playwright/test": "^1.65.1",
		"@rtk-query/codegen-openapi": "^2.2.0",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/react-vite": "^10.6.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.4.3",
		"@types/lodash": "^4.14.191",
		"@types/node": "^18.11.9",
		"@types/ramda": "^0.31.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "5.0.5",
		"gh-pages": "^5.0.0",
		"husky": "^9.1.7",
		"jsdom": "^21.1.1",
		"lint-staged": "^13.2.2",
		"storybook": "^10.6.7",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.2",
		"vite": "^7.3.8",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-svgr": "^5.2.0",
		"vite-tsconfig-paths": "^4.3.2",
		"vitest": "5.0.5"
	},
	"packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447",
	"resolutions": {
		"form-data": "^4.0.6",
		"@babel/runtime": "^7.29.14",
		"**/lint-staged/micromatch": "^4.0.8",
		"**/lint-staged/yaml": "^2.8.3",
		"**/workbox-build/glob": "^14.0.6",
		"**/@joshwooding/vite-plugin-react-docgen-typescript/glob": "^14.0.6"
	}
}
