		"yup": "^1.3.0"
	},
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"storybook": "storybook dev -p 6006 --host 0.0.0.0",
		"build-storybook": "storybook build",
		"build": "tsc && vite build",
		"build-staging": "tsc && vite build --mode staging",
		"serve": "vite preview",
		"test": "vitest",
		"test:withoutWatch": "vitest run",
		"typecheck": "tsc --noEmit",
		"fsd:check": "node scripts/check-fsd-boundaries.mjs",
		"fsd:check:changed": "node scripts/check-fsd-boundaries.mjs --changed",
		"fsd:check:working-tree": "node scripts/check-fsd-boundaries.mjs --working-tree",
		"fsd:check:ci": "node scripts/check-fsd-boundaries.mjs --ci-changed",
		"fsd:check:staged": "node scripts/check-fsd-boundaries.mjs --staged",
		"generate-api": "npx @rtk-query/codegen-openapi openapi-config.ts",
		"lint": "yarn typecheck && biome check src && yarn fsd:check:working-tree",
		"lint:fix": "yarn typecheck && biome check --write src && yarn fsd:check:working-tree",
		"biome": "biome check src --diagnostic-level=error",
		"biome:fix": "biome check --write src",
		"prepare": "husky",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist -t",
		"cypress:open": "npx cypress open",
		"cypress:run": "npx cypress run",
		"cypress:run:login": "npx cypress run --spec cypress/e2e/login.cy.ts"
	},
	"browserslist": {
		"production": [">0.2%", "not dead", "not op_mini all"],
		"development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@rtk-query/codegen-openapi": "^1.0.0-alpha.1",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/react-vite": "^10.4.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.4.3",
		"@types/lodash": "^4.14.191",
		"@types/node": "^18.11.9",
		"@types/ramda": "^0.31.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-basic-ssl": "^1.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-c8": "^0.31.0",
		"cypress": "15.17.0",
		"gh-pages": "^5.0.0",
		"husky": "^9.1.7",
		"jsdom": "^21.1.1",
		"lint-staged": "^13.2.2",
		"storybook": "^10.4.6",
		"ts-node": "^10.9.2",
		"vite": "^8.1.0",
		"vite-plugin-pwa": "^0.20.1",
		"vite-plugin-rewrite-all": "^1.0.2",
		"vite-plugin-svgr": "^2.4.0",
		"vite-tsconfig-paths": "^4.2.0",
		"vitest": "^4.0.16"
	},
	"packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
